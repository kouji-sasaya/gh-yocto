# Docker Image Configuration
# Customize the Docker image name
# Default: $(id -un)/yocto:local (your username will be used)
# DOCKER_IMAGE_NAME=myuser/yocto:local

# User Configuration
# USERNAME can be customized for the container account name.
# UID/GID are auto-detected from the host by gh-yocto (id -u / id -g).
# USERNAME=yocto
